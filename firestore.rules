rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/studylock_admins/$(request.auth.uid));
    }

    match /studylock_admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /studylock/{document=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // A 256-bit random capability token is generated on each student device and
    // stored only in that student's authenticated StudyLock state. The global
    // dashboard can discover it because only an approved admin may list users.
    // Student listeners may GET their known token document but cannot list tokens
    // or write control commands.
    match /studylock_control_channels/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /studylock_parent_channels/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.studentUid == null;

      allow update: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        (
          resource.data.studentUid == null &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.parentUid == resource.data.parentUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'studentUid',
            'connected',
            'studentOnline',
            'lastStudentSeenMs',
            'studentState',
            'updatedAtMs'
          ])
        ) ||
        (
          resource.data.studentUid == request.auth.uid &&
          request.resource.data.parentUid == resource.data.parentUid &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'connected',
            'studentOnline',
            'lastStudentSeenMs',
            'studentState',
            'updatedAtMs'
          ])
        )
      );

      allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;

      match /messages/{messageId} {
        function channel() {
          return get(/databases/$(database)/documents/studylock_parent_channels/$(code)).data;
        }

        function isParent() {
          return signedIn() && channel().parentUid == request.auth.uid;
        }

        function isStudent() {
          return signedIn() && channel().studentUid == request.auth.uid;
        }

        allow read: if isParent() || isStudent();
        allow create: if (isParent() || isStudent())
          && request.resource.data.senderUid == request.auth.uid
          && (
            (isParent() && request.resource.data.senderRole == 'parent') ||
            (isStudent() && request.resource.data.senderRole == 'student')
          );
        allow update, delete: if false;
      }
    }
  }
}
